{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Notebook",
  "version": "0.1.0",
  "identifier": "ai.opennotebook.desktop",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Notebook",
        "url": "loading.html",
        "width": 1280,
        "height": 860,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/surrealdb"
    ],
    "resources": {
      "resources/api": "api"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
